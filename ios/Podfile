# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

min_ios_version_supported = '15.5'  
platform :ios, min_ios_version_supported
prepare_react_native_project!
cpu_arch = `uname -m`.strip 

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Incyclist' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Google Maps SDK for iOS — Street View (GMSPanoramaView).
  #
  # iOS has no native Street View, so the ride screen's 'sv' view needs Google's
  # SDK here, the way Android needs play-services-maps.
  #
  # Pinned to 9.4.0, exactly, for two reasons:
  #
  #   1. It is the last release supporting iOS 15 (podspec: ios "15.0"). Every
  #      10.x requires iOS 16, which would raise min_ios_version_supported and
  #      make the app uninstallable on the iPhone 6s used for device testing.
  #   2. A pessimistic constraint (~> 9.4) would silently pick up a 9.x that
  #      moved the floor. This dependency is not one to let drift on its own.
  #
  # Note for whoever upgrades this: Google deprecated CocoaPods for the Maps SDK
  # as of 11.0.0 (Aug 2026) — 10.15.0 is the last CocoaPods release ever. Moving
  # past it means migrating this dependency to Swift Package Manager.
  #
  # Deliberately NOT wrapped in use_frameworks!: the podspec ships
  # GoogleMaps.xcframework as vendored_frameworks, which CocoaPods links and
  # embeds without it. Turning use_frameworks! on would rewrite linkage for every
  # pod in this project, MapLibre and the Nitro/MMKV stack included.
  pod 'GoogleMaps', '9.4.0'

  post_install do |installer|
    
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    

    installer.pods_project.build_configurations.each do |config|
      if cpu_arch == 'x86_64'
        config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "arm64"
      else
        config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "x86_64"
      end
    end
    
    # Add this inside your existing post_install do |installer| block
    installer.pods_project.targets.each do |target|

      if target.name == 'react-native-native-mqtt'
        target.build_configurations.each do |config|
          # This tells Xcode to ignore the bundled files that cause duplicates
          config.build_settings['EXCLUDED_SOURCE_FILE_NAMES'] = 'GCDAsyncSocket.m GCDAsyncUdpSocket.m'
        end
      end

      # Force every target to match your Intel Mac architecture
      target.build_configurations.each do |config|
        if cpu_arch == 'x86_64'
          config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "arm64"
        else
          config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "x86_64"
        end
      end      

      $MLRN.post_install(installer)

    end
    
    
  end
end
